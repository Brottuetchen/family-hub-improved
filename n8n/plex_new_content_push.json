{
  "name": "Plex - New Content Push (via Backend)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "value": 15
            }
          ]
        }
      },
      "id": "5f6f2f3f-8f2c-4b9c-8a3e-1e2c6a7b8c9d",
      "name": "Schedule (15 Min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://192.168.188.150:8000/api/plex/stats",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-4a9b-8c7d-6e5f4a3b2c1d",
      "name": "Get Plex Stats via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "functionCode": "const newItems = $json.recently_added;\nif (!newItems || !Array.isArray(newItems)) {\n  return [];\n}\n\nconst staticData = this.getWorkflowStaticData('global');\n\nif (!staticData.notifiedItems) {\n  staticData.notifiedItems = [];\n}\n\nconst itemsToNotify = [];\nfor (const item of newItems) {\n  if (item.ratingKey && !staticData.notifiedItems.includes(item.ratingKey)) {\n    itemsToNotify.push(item);\n    staticData.notifiedItems.push(item.ratingKey);\n  }\n}\n\nstaticData.notifiedItems = staticData.notifiedItems.slice(-1000);\n\nreturn itemsToNotify.map(item => ({ json: item }));"
      },
      "id": "d4e5f6a7-b8c9-4d8e-bf0a-9b8c7d6e5f4a",
      "name": "Filter New Items",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "id": "f6a7b8c9-d8e7-4f0a-d1c2-bd0e9f7a6b5c",
      "name": "SplitInBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://192.168.188.150:8000/api/push/notify",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ \"title\": \"Neuer Inhalt in Plex! 🍿\", \"body\": $json.title + \" ist jetzt zum Streamen verfügbar!\", \"url\": \"/\" }) }}",
        "options": {}
      },
      "id": "e5f6a7b8-c9d8-4e9f-c0b1-ac9d8e7f6a5b",
      "name": "Send Push Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1250,
        300
      ],
      "credentials": {}
    }
  ],
  "connections": {
    "Schedule (15 Min)": {
      "main": [
        [
          {
            "node": "Get Plex Stats via Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Plex Stats via Backend": {
      "main": [
        [
          {
            "node": "Filter New Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter New Items": {
      "main": [
        [
          {
            "node": "SplitInBatches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SplitInBatches": {
      "main": [
        [
          {
            "node": "Send Push Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": {
    "global": {
      "notifiedItems": []
    }
  },
  "tags": [
    "plex",
    "push",
    "media",
    "backend"
  ],
  "versionId": "0c1b2d3e-4f5a-6b7c-8d9e-0f1a2b3c4d5e"
}