{
  "name": "Weekly Media Newsletter + Push",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 12 * * 5"
            }
          ]
        }
      },
      "name": "Schedule - Freitag 12:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "python \"C:\\Users\\trapp\\homelab\\scripts\\media\\weekly_newsletter.py\""
      },
      "name": "Execute Newsletter Script",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.code}}",
              "operation": "equal",
              "value2": "0"
            }
          ]
        }
      },
      "name": "IF Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "http://192.168.188.150:8000/api/push/notify",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"title\": \"📰 Neuer Newsletter verfügbar!\",\n  \"body\": \"Deine wöchentlichen Film- und Serien-Highlights sind da!\",\n  \"url\": \"/index.html#newsletter\"\n}"
      },
      "name": "Send Push Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 200]
    },
    {
      "parameters": {
        "message": "=✅ Newsletter erfolgreich erstellt und Push gesendet!\n\nPush Stats:\n- Erfolgreich: {{$json.success}}\n- Fehlgeschlagen: {{$json.failed}}"
      },
      "name": "Log Success",
      "type": "n8n-nodes-base.logger",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "message": "=❌ Newsletter-Script fehlgeschlagen!\n\nFehler:\n{{$json.stderr}}"
      },
      "name": "Log Error",
      "type": "n8n-nodes-base.logger",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Schedule - Freitag 12:00": {
      "main": [
        [
          {
            "node": "Execute Newsletter Script",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Newsletter Script": {
      "main": [
        [
          {
            "node": "IF Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Success": {
      "main": [
        [
          {
            "node": "Send Push Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Push Notification": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
