# ============================================================
# Hermes Family OS — Konfiguration
# Kopiere diese Datei zu ".env" und passe die Werte an.
# ALLE Connectors sind optional: nicht gesetzt = Demo-/Aus-Modus.
# ============================================================

# --- App / Server ---
ENVIRONMENT=development            # development | production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
TIMEZONE=Europe/Berlin
# TLS-Zertifikate der Connectors prüfen (im Homelab ggf. false)
VERIFY_TLS=true

# --- Security (WICHTIG in Produktion setzen!) ---
# Erzeuge z.B. mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Hinter HTTPS-Reverse-Proxy oft false lassen (Backend sieht HTTP)
SECURE_COOKIES=false
# Kommagetrennt, oder * für alle
CORS_ORIGINS=*

# --- Datenbank / Cache ---
# SQLite (Standard, Zero-Config) oder PostgreSQL (Produktion)
DATABASE_URL=sqlite:///./hermes.db
# DATABASE_URL=postgresql+psycopg2://hermes:hermes@localhost:5432/hermes
# Hinweis: Der Host 'db' in DATABASE_URL gilt NUR in docker-compose (Service-Name).
# Bare-metal: SQLite (oben) oder die echte Postgres-Host-Adresse verwenden – NICHT 'db'.
REDIS_URL=

# --- Gebündelte Dienste (vom Installer per Docker startbar; siehe docs/SELFHOSTED.md) ---
# COMPOSE_PROFILES aktiviert die selbst-installierten Dienste – Docker Compose liest
# das automatisch, d.h. 'docker compose up -d' startet genau diese mit. Vom Installer
# gesetzt, z.B.:  COMPOSE_PROFILES=agent,radicale,vikunja,kitchenowl,paperless,homebox
COMPOSE_PROFILES=
# Adresse DIESES Servers für die Web-UIs der gebündelten Dienste (Browser):
PUBLIC_HOST=
# Secrets / Public-URLs (der Installer erzeugt sie automatisch beim "installieren"):
VIKUNJA_JWTSECRET=
VIKUNJA_PUBLICURL=
KITCHENOWL_JWT_SECRET=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_PUBLICURL=
# Gemeinsamer Admin-Login für die selbst-installierten Dienste. Erzeugt der
# Installer automatisch (backend/scripts/provision_tokens.py) und nutzt ihn, um die
# API-Tokens (VIKUNJA_TOKEN/KITCHENOWL_TOKEN/PAPERLESS_TOKEN/HOMEBOX_TOKEN) selbst
# anzulegen. Mit diesen Daten meldest du dich auch in den Weboberflächen an.
BUNDLE_ADMIN_USER=hermes
BUNDLE_ADMIN_EMAIL=hermes@family.local
BUNDLE_ADMIN_PASSWORD=
# Homebox-Pflicht-Secret (>= 32 Byte) – ohne dieses startet Homebox nicht.
# Der Installer erzeugt es automatisch beim "installieren".
HOMEBOX_API_KEY_PEPPER=
# Optionale Port-Overrides der gebündelten Dienste:
# RADICALE_PORT=5232 · VIKUNJA_PORT=3456 · KITCHENOWL_PORT=8082 · PAPERLESS_PORT=8081 · HOMEBOX_PORT=7745

# Für docker-compose (Postgres):
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hermes

# --- Push Notifications (Web Push / VAPID) ---
# Erzeuge mit: cd backend && python -m scripts.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# --- Wetter (Open-Meteo, kostenlos, kein Key) ---
WEATHER_ENABLED=true
WEATHER_LATITUDE=52.52
WEATHER_LONGITUDE=13.405
WEATHER_LOCATION_NAME=Zuhause

# --- Connector: Kalender (CalDAV / Nextcloud) ---
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# --- Connector: Aufgaben (Vikunja) ---
VIKUNJA_URL=
VIKUNJA_TOKEN=

# --- Connector: Einkauf (KitchenOwl) ---
KITCHENOWL_URL=
KITCHENOWL_TOKEN=

# --- Connector: Dokumente (Paperless-ngx) ---
PAPERLESS_URL=
PAPERLESS_TOKEN=

# --- Connector: Inventar (Homebox) ---
HOMEBOX_URL=
HOMEBOX_TOKEN=

# --- Connector: Smart Home (Home Assistant) ---
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=

# --- Connector: Medien (Plex, optional) ---
PLEX_URL=
PLEX_TOKEN=

# --- Connector: Hörbücher (Audiobookshelf, optional) ---
AUDIOBOOKSHELF_URL=
AUDIOBOOKSHELF_TOKEN=

# --- Connector: Tonies (TeddyCloud, optional, kein Token) ---
TEDDYCLOUD_URL=

# --- Connector: Media-Requests (Overseerr, optional) ---
OVERSEERR_URL=
OVERSEERR_API_KEY=

# --- Connector: Serien (Sonarr, optional) ---
SONARR_URL=
SONARR_API_KEY=
# Optional: sonst wird das erste vorhandene Profil / der erste Root-Folder genutzt.
# SONARR_QUALITY_PROFILE_ID=
# SONARR_ROOT_FOLDER=

# --- Connector: Filme (Radarr, optional) ---
RADARR_URL=
RADARR_API_KEY=
# RADARR_QUALITY_PROFILE_ID=
# RADARR_ROOT_FOLDER=

# --- Homelab-Status-Board (optional): up/down + Links für Dienste ohne tiefe Integration ---
# JSON-Liste (kompakt, ohne Leerzeichen). Beispiel:
# HOMELAB_SERVICES=[{"name":"SABnzbd","url":"http://192.168.1.90:8080","category":"automation","icon":"📥"},{"name":"Immich","url":"http://192.168.1.94:2283","category":"fotos","icon":"📷"}]
HOMELAB_SERVICES=

# --- Hermes AI (NousResearch/hermes-agent als Gehirn) ---
# Der Chat ist NUR ein Client zum hermes-agent-Sidecar – kein eigener Agent,
# kein Wort-Matcher. AI_PROVIDER kennt zwei sinnvolle Werte:
#   hermes_agent = mit dem Sidecar verbunden (empfohlen)
#   none / leer  = Chat inaktiv (klarer Hinweis statt Fake-Antwort)
# Am einfachsten über den Installer setzen:  ./install.sh
AI_ENABLED=true
AI_PROVIDER=none

# Sidecar verbinden (siehe docs/HERMES_AGENT.md).
# Starten:  docker compose --profile agent up -d --build   (startet auch hermes-mcp)
# AI_PROVIDER=hermes_agent
# API-Server des Sidecars (OpenAI-kompatibel), Default-Port 8642:
HERMES_AGENT_URL=http://hermes-agent:8642/v1
# Optionales Web-Dashboard (falls die gepinnte Version eines mitbringt) für /agent:
HERMES_AGENT_DASHBOARD_URL=
HERMES_AGENT_MODEL=default
# Bearer-Token = API_SERVER_KEY des Sidecars (schützt den API-Server). Leer = offen im internen Netz.
HERMES_AGENT_TOKEN=

# Sprach-Transkription (Voice-Messages) über den Sidecar, Whisper-kompatibel:
AI_MAX_TOKENS=1024
AI_TRANSCRIBE_MODEL=whisper-1
