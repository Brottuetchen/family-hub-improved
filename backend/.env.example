# Family Hub Backend Configuration
# Kopiere diese Datei zu .env und fülle die Werte aus

# FastAPI Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# VAPID Keys für Push Notifications
# Generiere mit: python -c "from pywebpush import WebPusher; keys = WebPusher.create_keys(); print('PRIVATE:', keys['private_key'].decode()); print('PUBLIC:', keys['public_key'].decode())"
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_EMAIL=mailto:trapp.constantin@gmail.com

# Plex Configuration
PLEX_URL=http://192.168.188.7:32400
PLEX_TOKEN=oe1a9iRoLZktgJEAXFvo

# Overseerr Configuration
OVERSEERR_URL=http://192.168.188.79:5055
OVERSEERR_API_KEY=MTc1ODU1NDgxMzY0NGE3MWZjZDY4LWJhMzItNGI5NC1hNDNiLWEyZWViODE4MmE2OQ==

# Sonarr Configuration (optional)
SONARR_URL=http://192.168.188.71:8989
SONARR_API_KEY=c06e12e1596e42b19cfdff8963a70b4c

# Radarr Configuration (optional)
RADARR_URL=http://192.168.188.73:7878
